# ==========================================
# SAVE & LOAD PLAYER (YAML)
# ==========================================


def save_player(player)
  player_data = {
    "name" => player.name,
    "id" => player.id,
    "character_class" => player.character_class,
    "level" => player.level,
    "xp" => player.xp,
    "health" => player.health,
    "attack" => player.attack,
    "defence" => player.defence
  }

  yaml_data = YAML.dump(player_data)

  File.write("player_data.yml", yaml_data)

  puts "\nGame saved successfully!"

rescue SystemCallError => e
  puts "Could not save game: #{e.message}"
end


def load_player
  unless File.exist?("player_data.yml")
    puts "No saved game found!"
    return nil
  end

  loaded_data = YAML.safe_load_file("player_data.yml")
unless loaded_data.is_a?(Hash)
  puts "saved gamefile is empty or currupted."
  return nil
end
  player = Player.new(
    loaded_data["name"],
    loaded_data["character_class"],
    loaded_data["health"],
    loaded_data["attack"],
    loaded_data["defence"],
    id: loaded_data["id"],
    level: loaded_data["level"],
    xp: loaded_data["xp"]
  )

  puts "\nGame loaded successfully!"
  player.display_info

  player

rescue SystemCallError, Psych::Exception, ArgumentError => e
  puts "Could not load game: #{e.message}"
  nil
end


