# ==========================================
# COMBAT ENGINE CLASS
# ==========================================

class CombatEngine
    include LoggerModule

  def initialize(player, enemy)
    @player = player
    @enemy = enemy
    @defending = false
  end

  def test_connection
    puts "Player attack: #{@player.attack}"
    puts "Enemy attack: #{@enemy.attack}"
  end

  # Player attacks enemy
  def player_attack
    log_event("Player attacked the enemy")

    damage = [@player.attack - @enemy.defence, 0].max

    puts "Player deals #{damage} damage"

    @enemy.take_damage(damage)
  end

  # Enemy attacks player
  def enemy_attack
    log_event("Enemy attacked the player")
    damage = [@enemy.attack - @player.defence, 0].max

    if @defending
      damage /= 2
      puts "Player defended, reduced damage: #{damage}"
    else
      puts "Enemy deals #{damage} damage"
    end

    @defending = false

    @player.take_damage(damage)
  end

  # Player defends
  def defend

    log_event("Player defended")

    @defending = true
    puts "Player is defending"
  end

  # Player tries to escape
  def run

  log_event("Player tried to escape")

    roll = rand(1..2)

    if roll == 1
      puts "You escaped"
      true
    else
      puts "Escape failed; the enemy attacks"
      false
    end
  end

  # Main battle loop
  def start_battle

    log_event("Battle started")

    loop do
      break unless @enemy.alive? && @player.alive?

      puts "\n choose your action"
      puts "1. attack"
      puts "2. defend"
      puts "3. run"

      print "enter your choice: "
      choice=gets.chomp.strip.downcase

      case choice

      when "1"
        player_attack
      when "2"
        defend

      when "3"
        if run
          
          break
        end

      else
        puts "Invalid choice, try again"
        next
      end

      break unless @enemy.alive?

      enemy_attack

      unless @player.alive?
        log_event("Player was defeated")
        puts "You are defeated"
        break
      end
    end

    # Give XP only when enemy is defeated
    unless @enemy.alive?
      reward = @enemy.level * 20

      puts "Congratulations! You defeated the enemy"

      @player.gain_xp(reward)
    end
  end
end


