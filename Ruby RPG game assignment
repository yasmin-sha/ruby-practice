module LoggerModule

  def log_event(message)
    File.open("battle_log.txt", "a") do |file|
      file.puts "#{Time.now} - #{message}"
    end
  end

end

# ==========================================
# PLAYER CLASS
# ==========================================


class Player
  attr_reader :name, :id, :character_class, :attack, :defence, :health, :xp, 

  def initialize(name, character_class, health, attack, defence,
    id: SecureRandom.uuid, level: 1, xp: 0)

@name = name
@id = id
@character_class = character_class
@level = level
@xp = xp
@health = health
@attack = attack
@defence = defence

end

  def alive?
    @health > 0
  end

  def display_info
    puts "\nPLAYER INFORMATION"
    puts "Name: #{@name}"
    puts "ID: #{@id}"
    puts "Character Class: #{@character_class}"
    puts "Level: #{@level}"
    puts "XP: #{@xp}"
    puts "Health: #{@health}"
    puts "Attack: #{@attack}"
    puts "Defence: #{@defence}"
  end

  def take_damage(damage)
    @health -= damage
    @health = 0 if @health < 0
    puts "Remaining Health: #{@health}"
  end

  # Add XP to the player
  def gain_xp(amount)
    return if amount <= 0

    @xp += amount

    puts "#{@name} earned #{amount} XP"
    puts "Total XP: #{@xp}"

    while @xp >= (@level * 100)
      level_up
    end
  end

  # Increase player level
  def level_up
    @xp -= (@level * 100)
    @level += 1

    puts "Level up! You are now Level #{@level}"
  end
end


