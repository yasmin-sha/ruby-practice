class Enemy
    attr_reader :attack, :defence, :health
    def initialize(name,level,health,attack,defence)
        @name=name
        @level=level
        @health= health
        @attack=attack
        @defence=defence
    end
    def display_info
        puts "ENEMY INFORMATION\n"
        puts "Name:  #{@name}\n"
        puts "Level:  #{@level}\n"
        puts "Health:  #{@health}\n" 
        puts "Attack:  #{@attack}\n"
        puts "Defence:  #{@defence}"
    end
    def alive?
        @health>0
    end
    def take_damage(damage)
        @health -= damage
        @health = 0 if @health < 0
        puts "Remaining Health: #{@health}"
    end
end
