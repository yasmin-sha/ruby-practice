
require 'securerandom'

module Formatter
    def self.format_title(title)
      cleaned=title.to_s.strip.gsub(/\s+/ ,' ').upcase
      header="-"*(cleaned.length)
       "#{header}\n #{cleaned}\n  #{header}"
    end
end
puts Formatter.format_title("RUBY RPG GAME")
class Player
    attr_reader :attack, :defence, :health
        def initialize(name, character_class, health, attack, defence)
        @name=name
        @id = SecureRandom.uuid
        @character_class=character_class
        @level=1
        @xp=0
        @health= health
        @attack=attack
        @defence=defence
     
    end
    def alive?
       @health > 0
    end
    def display_info
        puts "\n\n"
        puts "PLAYER INFORMATION\n"
        puts "Name:  #{@name}\n"
        puts "ID:   #{@id}\n "
        puts "Character_class:  #{@character_class}\n"
        puts "Level:  #{@level}\n"
        puts "XP:  #{@xp}\n"
        puts "Health:  #{@health}\n" 
        puts "Attack:  #{@attack}\n"
        puts "Defence:  #{@defence}"
    end
        def take_damage(damage)
        @health -= damage
        @health = 0 if @health < 0
        puts "Remaining Health: #{@health}"
    end
    
end


